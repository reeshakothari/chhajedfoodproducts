# Service role key -- SERVER ONLY. Set in .env.local / Vercel, not here.
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here

# --- Admin console auth (username + password) --------------------------
# One shared login for /admin. Set real values in .env.local / Vercel.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-to-a-strong-password
# Random 32+ char string used to sign the session cookie
# (generate: openssl rand -base64 32)
ADMIN_SESSION_SECRET=change-me-to-a-long-random-string

